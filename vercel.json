{
  "crons": [
    {
      "path": "/api/cron/update-live",
      "schedule": "30 16 * * 1-5"
    },
    {
      "path": "/api/cron/trigger-news",
      "schedule": "*/20 0-11,13-23 * * *"
    },
    {
      "path": "/api/cron/trigger-news",
      "schedule": "0,30 12 * * *"
    },
    {
      "path": "/api/cron/trigger-daily-apac",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/trigger-daily-eu-us",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/trigger-report",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/trigger-daily-eu",
      "schedule": "0 19 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/yahoo-news(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=1800, stale-while-revalidate=3600"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/api/ticker-news(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=1800, stale-while-revalidate=3600"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/api/indices(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=1800, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "source": "/stock/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/value",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/sectors",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/news",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/research(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/about",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/legal",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}