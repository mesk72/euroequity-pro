# ============================================================
# FORWARDALPHA — Dockerfile per Cloud Run
# ============================================================
FROM python:3.11-slim

WORKDIR /app

# Installa dipendenze sistema
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copia requirements e installa
COPY requirements_gcp.txt .
RUN pip install --no-cache-dir -r requirements_gcp.txt

# Copia tutti gli script Python
COPY app_gcp.py .
COPY daily_eu.py .
COPY daily_apac.py .
COPY daily_us.py .
COPY weekly_eu.py .
COPY weekly_apac.py .
COPY weekly_us.py .
COPY fetch_news_cache.py .
COPY fix_combined_rank.py .

# Variabili ambiente (i secrets vengono da GCP Secret Manager)
ENV PORT=8080
ENV PYTHONUNBUFFERED=1

EXPOSE 8080

CMD ["python", "app_gcp.py"]
